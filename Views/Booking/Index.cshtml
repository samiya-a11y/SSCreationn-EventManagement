@model SSCreationnProject.Models.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Owner Dashboard - SS Creationn";
}

<div class="container py-5">

    <!-- ============ HEADER ============ -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 ssc-fade">
        <div>
            <span class="ssc-kicker">Owner Control Panel</span>
            <h2 class="ssc-title mb-0">Inquiries &amp; <em>Portfolio</em></h2>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Gallery" asp-action="Create" class="btn btn-gold px-4">
                + Add Past Event
            </a>
            <a asp-action="Logout" class="btn btn-outline-danger px-4">
                Logout
            </a>
        </div>
    </div>

    <!-- ============ STATS ============ -->
    
    <div class="row g-3 mb-4 ssc-fade" style="--d: .1s">
        <div class="col-sm-6">
            <div class="ssc-stat">
                <div class="ssc-stat-icon">📋</div>
                <div><strong>@Model.Bookings.Count</strong><span>Client Inquiries</span></div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="ssc-stat">
                <div class="ssc-stat-icon">🖼️</div>
                <div><strong>@Model.Events.Count</strong><span>Gallery Events</span></div>
            </div>
        </div>
    </div>

    <!-- ============ SEARCH ============ -->
    <form asp-action="Index" method="get" class="mb-5 ssc-fade" style="--d: .15s">
        <div class="ssc-search">
            <input type="text" name="searchString" placeholder="Search by client name or phone number..." aria-label="Search inquiries" />
            <button class="btn btn-gold px-4" type="submit">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-3 d-none d-sm-inline-flex align-items-center">Reset</a>
        </div>
    </form>

    <!-- ============ SECTION 1: BOOKINGS ============ -->
    <div class="mb-3">
        <h4 class="mb-0" style="font-size: 1.9rem; font-weight: 600;">Client Inquiries</h4>
        <p class="text-muted small mb-0">Select a client name to view the full inquiry.</p>
    </div>

    <div class="ssc-table-card mb-5">
        <div class="table-responsive">
            <table class="table table-hover align-middle ssc-table">
                <thead>
                    <tr>
                        <th class="ps-4">Client</th>
                        <th>Contact No.</th>
                        <th>Occasion</th>
                        <th>Date</th>
                        <th>Estimated Budget</th>
                        <th class="text-center pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Bookings != null && Model.Bookings.Any())
                {
                    foreach (var item in Model.Bookings)
                    {
                        <tr>
                            <td class="ps-4">
                                <a href="javascript:void(0);"
                                   class="fw-semibold text-decoration-none"
                                   style="color: var(--ssc-gold-dark); font-size: 1.05rem;"
                                   data-bs-toggle="modal"
                                   data-bs-target="#clientModal-@item.Id">
                                    @item.ClientName
                                </a>
                                <div class="small text-muted">Inquiry #SS-@item.Id</div>
                            </td>
                            <td>
                                <a href="tel:@item.PhoneNumber" class="text-decoration-none fw-medium" style="color: var(--ssc-ink);">
                                    @item.PhoneNumber
                                </a>
                            </td>
                            <td><span class="ssc-tag">@item.EventType</span></td>
                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                            <td class="fw-semibold" style="color: var(--ssc-gold-dark);">₹@item.EstimatedBudget.ToString("N0")</td>
                            <td class="text-center pe-4">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this inquiry?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">No inquiries found.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ============ SECTION 2: PORTFOLIO ============ -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end mb-3 gap-2">
        <div>
            <h4 class="mb-0" style="font-size: 1.9rem; font-weight: 600;">Manage Event Portfolio</h4>
            <p class="text-muted small mb-0">Update titles, dates, descriptions, or replace photos.</p>
        </div>
        <a asp-controller="Gallery" asp-action="Create" class="btn btn-gold btn-sm px-4">+ Add New Event</a>
    </div>

    <div class="ssc-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle ssc-table">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 90px;">Photo</th>
                        <th>Event Title</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Date</th>
                        <th class="text-center pe-4" style="width: 190px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Events != null && Model.Events.Any())
                {
                    foreach (var ev in Model.Events)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (!string.IsNullOrEmpty(ev.ImageUrl))
                                {
                                    <img src="@ev.ImageUrl" width="64" height="46" class="rounded-3 object-fit-cover shadow-sm" style="border: 1px solid var(--ssc-gold-soft);" alt="@ev.Title" loading="lazy" />
                                }
                                else
                                {
                                    <span class="small text-muted">No pic</span>
                                }
                            </td>
                            <td class="fw-semibold">@ev.Title</td>
                            <td><span class="ssc-tag ssc-tag-gold">@ev.Category</span></td>
                            <td>@ev.Location</td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center pe-4">
                                <button type="button" class="btn btn-sm btn-outline-gold px-3 me-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editEventModal-@ev.Id">
                                    Edit
                                </button>
                                <form asp-controller="Gallery" asp-action="Delete" asp-route-id="@ev.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this event entry and image?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">No events found in the portfolio.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============ MODALS (kept outside the tables for valid markup) ============ -->
@if (Model.Bookings != null)
{
    foreach (var item in Model.Bookings)
    {
        <div class="modal fade ssc-modal" id="clientModal-@item.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <span class="ssc-chip ssc-chip-gold ssc-chip-static mb-2">Inquiry #SS-@item.Id</span>
                            <h5 class="modal-title">@item.ClientName</h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="ssc-detail-card mb-3">
                            <h6>Contact Info</h6>
                            <dl class="row mb-0">
                                <dt class="col-4">Phone</dt>
                                <dd class="col-8"><a href="tel:@item.PhoneNumber" class="text-decoration-none">@item.PhoneNumber</a></dd>
                                <dt class="col-4">Email</dt>
                                <dd class="col-8 mb-0 text-break">@item.Email</dd>
                            </dl>
                        </div>
                        <div class="ssc-detail-card mb-3">
                            <h6>Event Specs</h6>
                            <dl class="row mb-0">
                                <dt class="col-5">Category</dt>
                                <dd class="col-7" style="color: var(--ssc-gold-dark);">@item.EventType</dd>
                                <dt class="col-5">Date</dt>
                                <dd class="col-7">@item.EventDate.ToString("dd MMMM yyyy")</dd>
                                <dt class="col-5">Guests</dt>
                                <dd class="col-7">@item.GuestCount Persons</dd>
                                <dt class="col-5">Budget</dt>
                                <dd class="col-7" style="color: var(--ssc-gold-dark);">₹@item.EstimatedBudget.ToString("N0")</dd>
                                <dt class="col-5">Venue</dt>
                                <dd class="col-7 mb-0">@item.VenueLocation</dd>
                            </dl>
                        </div>
                        <div class="ssc-detail-card">
                            <h6>Special Demands</h6>
                            <p class="small text-secondary mb-0">@(string.IsNullOrWhiteSpace(item.SpecialRequests) ? "None specified." : item.SpecialRequests)</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="tel:@item.PhoneNumber" class="btn btn-gold btn-sm px-4">Call Client</a>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (Model.Events != null)
{
    foreach (var ev in Model.Events)
    {
        <div class="modal fade ssc-modal" id="editEventModal-@ev.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Update Event: @ev.Title</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-controller="Gallery" asp-action="Edit" asp-route-id="@ev.Id" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@ev.Id" />

                        <div class="modal-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label">Event Title</label>
                                    <input type="text" name="Title" class="form-control" value="@ev.Title" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Category</label>
                                    <select name="Category" class="form-select">
                                        <option value="Wedding" selected="@(ev.Category == "Wedding")">Wedding</option>
                                        <option value="Corporate" selected="@(ev.Category == "Corporate")">Corporate</option>
                                        <option value="Birthday" selected="@(ev.Category == "Birthday")">Birthday</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Location / Venue</label>
                                    <input type="text" name="Location" class="form-control" value="@ev.Location" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Event Date</label>
                                    <input type="date" name="EventDate" class="form-control" value="@ev.EventDate.ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Description / Highlights</label>
                                    <textarea name="Description" class="form-control" rows="3">@ev.Description</textarea>
                                </div>

                                <div class="col-12 pt-3 mt-2" style="border-top: 1px solid var(--ssc-gold-soft);">
                                    <label class="form-label d-block">Current Photograph</label>
                                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                                        @if (!string.IsNullOrEmpty(ev.ImageUrl))
                                        {
                                            <img src="@ev.ImageUrl" width="130" height="88" class="rounded-3 object-fit-cover shadow-sm" style="border: 1px solid var(--ssc-gold-soft);" alt="Preview" loading="lazy" />
                                        }
                                        <div class="flex-grow-1">
                                            <label class="form-label">Replace Image (Optional)</label>
                                            <input type="file" name="newImageFile" class="form-control form-control-sm" accept="image/*" />
                                            <small class="text-muted">Upload high-res JPG, PNG, or WEBP.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-gold px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
