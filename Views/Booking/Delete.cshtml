@model SSCreationnProject.Models.Booking

@{
    ViewData["Title"] = "Delete Booking Inquiry";
}

<div class="container py-5">
    <div class="ssc-auth-card mx-auto" style="max-width: 560px;">
        <div class="ssc-danger-head">
            <h5>Cancel / Remove Inquiry</h5>
        </div>
        <div class="ssc-auth-body">
            <p class="fw-semibold mb-4" style="color: #8f2b1d;">Are you sure you want to permanently delete this inquiry record?</p>
            <div class="ssc-detail-card">
                <dl class="row mb-0">
                    <dt class="col-5">Client</dt>
                    <dd class="col-7 fw-semibold">@Model.ClientName</dd>

                    <dt class="col-5">Contact</dt>
                    <dd class="col-7">@Model.PhoneNumber</dd>

                    <dt class="col-5">Event Type</dt>
                    <dd class="col-7">@Model.EventType</dd>

                    <dt class="col-5">Event Date</dt>
                    <dd class="col-7">@Model.EventDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-5">Budget</dt>
                    <dd class="col-7 mb-0">₹@Model.EstimatedBudget.ToString("N0")</dd>
                </dl>
            </div>
        </div>
        <div class="ssc-auth-foot">
            <form asp-action="Delete" class="d-flex justify-content-end gap-2">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                <input type="submit" value="Confirm Delete" class="btn btn-danger rounded-pill px-4" />
            </form>
        </div>
    </div>
</div>
